# Caddy del host · arb-a.servicios.care
#
# La app corre en el contenedor `app-arb-a` (php-fpm en 9000) y el código está en
# /opt/arb-a/app. Caddy termina TLS y le pasa la petición a PHP.
#
# Las dos reescrituras son obligatorias: sin ellas /api/upload y /d/<token> caen en
# /index.php (comportamiento de try_files) y la API responde otra cosa.

arb-a.servicios.care {
	encode zstd gzip
	root * /opt/arb-a/app/public

	# POST /api/upload  ->  api/upload.php
	@carga path /api/upload
	rewrite @carga /api/upload.php

	# GET /d/<token>  ->  d.php (el script lee el token del REQUEST_URI)
	@descarga path /d/*
	rewrite @descarga /d.php

	php_fastcgi app-arb-a:9000
	file_server

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}

# La IP real del cliente llega por X-Forwarded-For; el contenedor solo la cree si su
# REMOTE_ADDR está en ARB_A_PROXY_IPS. Ajustar a la IP del contenedor de Caddy en `redweb`:
#   docker network inspect redweb --format '{{range .Containers}}{{.Name}} {{.IPv4Address}}{{end}}'
