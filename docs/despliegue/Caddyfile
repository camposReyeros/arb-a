# Caddy del host · arb-a.servicios.care
#
# Caddy corre en el contenedor `caddy` (proyecto `/opt/insumos`) y termina TLS.
# La app es `app-arb-a` (php-fpm en 9000). El código se monta DOS veces:
#   - en el contenedor caddy:  /opt/arb-a/app -> /var/www/arb-a:ro
#   - en el contenedor app:    /opt/arb-a/app -> /var/www/arb-a
# Por eso el `root` de este bloque es la ruta DENTRO de caddy (/var/www/arb-a/public).
#
# Para agregar el montaje: editar /opt/insumos/compose.yml y
#   docker compose -f /opt/insumos/compose.yml up -d --no-deps caddy
# La Caddyfile está montada como bind de UN SOLO archivo: editarla en el mismo inodo
# (append con `>>` o `cat >`), nunca con `sed -i` (rompe el montaje).
#
# Las dos reescrituras son obligatorias: sin ellas /api/upload y /d/<token> caen en
# /index.php y la API responde otra cosa.

# Timeouts: los del upstream se fijan por sitio (aquí abajo); los del servidor HTTP
# (lectura del cuerpo del cliente) son globales por listener y van en el bloque de
# opciones del Caddyfile del host:
#
#   {
#       servers {
#           timeouts {
#               read_body 10m
#               idle 10m
#           }
#       }
#   }
#
# Sin eso, una subida lenta por un enlace malo puede cortarse a mitad del cuerpo.

arb-a.servicios.care {
	root * /var/www/arb-a/public
	encode gzip

	# POST /api/upload  ->  api/upload.php
	@carga path /api/upload
	rewrite @carga /api/upload.php

	# GET /d/<token>  ->  d.php?t=<token>
	# El token va en la query: tras el rewrite, REQUEST_URI ya es /d.php.
	@descarga path_regexp descarga ^/d/([a-f0-9]{64})/?$
	rewrite @descarga /d.php?t={re.descarga.1}

	# 300s de lectura/escritura hacia php-fpm: una subida de 64 MB con SMTP a varios
	# destinatarios puede tardar; el default es sin timeout, pero se fija explícito.
	php_fastcgi app-arb-a:9000 {
		read_timeout 300s
		write_timeout 300s
	}
	file_server
}

# La IP real del cliente llega por X-Forwarded-For; el contenedor solo la cree si su
# REMOTE_ADDR está en ARB_A_PROXY_IPS. Ese valor es la IP de caddy en la red `redweb`:
#   docker inspect caddy --format '{{(index .NetworkSettings.Networks "redweb").IPAddress}}'
# Si caddy se recrea puede cambiar: actualizar /opt/arb-a/.env y recrear app-arb-a.
