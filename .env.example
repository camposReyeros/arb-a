# copiar a .env (modo 600). Nada de secretos en el repo.
ARB_A_DB_USER=arb_a
ARB_A_DB_PASS=cambiame
ARB_A_APIKEY=cambiame-clave-de-api

# Perillas opcionales (defaults en config.example.php)
# ARB_A_DSN=pgsql:host=db-arb-a;port=5432;dbname=arb_a
# ARB_A_DIR=/var/lib/arb-a/archivos
# ARB_A_DIAS=90
# ARB_A_MAX_BYTES=67108864
# ARB_A_MAX_CARGAS_HORA=100
# ARB_A_APP_DIR=.   (en /opt/arb-a va ./app; sin comentario en la misma línea)
ARB_A_APP_DIR=.

ARB_A_SMTP_HOST=smtp.servicios.care
ARB_A_SMTP_PORT=587
ARB_A_SMTP_USER=noreply-arb-a@servicios.care
ARB_A_SMTP_PASS=cambiame
ARB_A_SMTP_FROM=noreply-arb-a@servicios.care
# ARB_A_SMTP_TIMEOUT=15

ARB_A_URL_BASE=https://arb-a.servicios.care

# IP(s) del proxy de confianza separadas por coma (Caddy). Sin esto no se cree X-Forwarded-*.
# ARB_A_PROXY_IPS=172.18.0.1
